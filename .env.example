# ─────────────────────────────────────────────────────────────────────────────
# ConfluenceAlertBot configuration
# Copy to .env (or set in your shell / service manager), then run:
#   python bot.py --once        # single scan cycle
#   python bot.py               # long-running daemon
# All of these are optional — every value has a safe default in config.py.
# ─────────────────────────────────────────────────────────────────────────────

# --- Telegram dispatch (required to actually send alerts) ---------------------
# Official Bot API. Get a token from @BotFather; get the chat/channel ID by
# adding the bot to the group and reading getUpdates, or use the channel ID
# with a leading '-100' for a private channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GMGN data ---------------------------------------------------------------
# All data reads go through the official `gmgn-cli` (installed globally), NOT
# direct HTTP — api.gmgn.ai sits behind Cloudflare and returns a 403 challenge
# to a plain HTTP client. Ensure:
#   1. `npm install -g gmgn-cli`
#   2. the API key is configured where gmgn-cli reads it:
#        gmgn-cli config            # prints a key-generation link
#        gmgn-cli config --apply <KEY>
#   3. `gmgn-cli config --check`   # exit 0
# The bot reuses the same key; nothing needs to be set here unless you want an
# explicit process-level override:
# GMGN_API_KEY=

# --- The confluence filter (overridable; defaults shown) ----------------------
# CONFLUENCE_MIN_MC=50000
# CONFLUENCE_MAX_MC=2000000
# CONFLUENCE_MAX_RUG_RATIO=0.40
# CONFLUENCE_MAX_BUNDLE_RATIO=0.30
# CONFLUENCE_MIN_HOLDERS=50
# CONFLUENCE_MIN_WALLET_MATCH=2

# --- The whitelist that drives the overlap gate --------------------------------
# The bot stays SILENT until at least CONFLUENCE_MIN_WALLET_MATCH of these
# wallets are found among a token's top holders. Set either the env var (space,
# comma or newline separated) or the file (one per line, '#' comments allowed);
# both are merged.
# GMGN_TARGET_WALLETS=addr1,addr2
# GMGN_TARGET_WALLETS_FILE=target_wallets.txt

# --- Runtime ----------------------------------------------------------------
# BOT_CHAIN=sol
# BOT_SCAN_INTERVAL=30            # seconds between scan cycles
# BOT_ERROR_SLEEP=10              # sleep on a crashed cycle
# BOT_MAX_SCAN_PER_CYCLE=10       # candidates vetted per cycle (rate-limit guard)
# BOT_STATE_FILE=bot_state.json   # stable path = dedupe survives restarts
# BOT_ALERT_REPEAT_MINUTES=1440   # don't re-alert same address for 24h
# BOT_LOG_LEVEL=INFO
# BOT_CLI_PACE_S=1.5              # min seconds between gmgn-cli calls (rate-limit guard)

# --- Alert ROI / PnL tracking ------------------------------------------------
# After an alert fires, the bot sends a PnL update every interval and a final
# verdict after the horizon. A token that drops >= BAD_CALL_PCT below its
# entry MC gets an immediate "bad call" verdict (self-evaluation).
# BOT_TRACK_FILE=alert_track.json          # persisted tracked alerts (survives restarts)
# BOT_TRACK_INTERVAL_MIN=30                # minutes between PnL updates per alert
# BOT_TRACK_HORIZON_HOURS=24               # track for this long after an alert, then verdict
# BOT_BAD_CALL_PCT=0.50                    # MC drop threshold for a "bad call" (0.5 = 50%)
